#!/bin/bash
# Git post-receive hook — deploys the site on every push to main.
set -euo pipefail

WEB_ROOT="${WEB_ROOT:-/var/www/fourthpin}"
BRANCH="${DEPLOY_BRANCH:-main}"

export GIT_WORK_TREE="$WEB_ROOT"
git checkout -f "$BRANCH"

cd "$WEB_ROOT"

if command -v python3 >/dev/null 2>&1 && [[ -f build.py ]]; then
  if python3 -c "import markdown, yaml" 2>/dev/null; then
    python3 build.py
  else
    echo "  (skipped build.py — pip install markdown pyyaml)"
  fi
fi

if id www-data >/dev/null 2>&1; then
  chown -R www-data:www-data "$WEB_ROOT"
fi

echo ""
echo "✓ Deployed $BRANCH → $WEB_ROOT"
echo ""
