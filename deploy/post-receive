#!/bin/bash
# Git post-receive hook — deploys the site on every push
#
# Setup:
#   1. On your server, create a bare repo:
#      git init --bare /home/deploy/yoursite.git
#
#   2. Copy this file to the bare repo's hooks directory:
#      cp post-receive /home/deploy/yoursite.git/hooks/post-receive
#      chmod +x /home/deploy/yoursite.git/hooks/post-receive
#
#   3. On your local machine, add the server as a remote:
#      git remote add origin ssh://user@YOUR_SERVER_IP/home/deploy/yoursite.git
#
#   4. Deploy by pushing:
#      git push origin main
#
# The hook fires automatically and copies files to the web root.

GIT_WORK_TREE=/var/www/yoursite git checkout -f main

echo ""
echo "✓ Deployed to /var/www/yoursite"
echo ""
